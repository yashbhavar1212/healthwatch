# Copy to .env and edit. Never commit the real .env file.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=Admin@123
WORKER_PASSWORD=Worker@123
DEMO_DATA=0            # 0 = start empty (default). 1 = load sample villages + 30 days of reports
PRODUCTION=0           # 1 = secure cookies (use on HTTPS hosting)
# DATABASE_PATH=instance/shms.db
# DATABASE_URL=postgresql://user:password@host/dbname   # online PostgreSQL (Neon); keeps data on free hosting

# Optional e-mail alerts for High / Critical reports
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# ALERT_EMAIL_TO=officer1@example.com,officer2@example.com
